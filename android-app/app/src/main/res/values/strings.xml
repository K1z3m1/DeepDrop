    <!-- First-launch disclosure screen, shown once before the home screen -->
    <string name="disclosure_title">Before you start</string>
    <string name="disclosure_subtitle">NovaFrame needs a few device permissions to generate frames over your games. Here\'s what each one is for — you can review or change any of them later from Settings.</string>
    <string name="disclosure_item_overlay_title">Display over other apps</string>
    <string name="disclosure_item_overlay_desc">Draws the frame-generation overlay on top of the game or app you\'re running.</string>
    <string name="disclosure_item_a11y_title">Accessibility service (optional)</string>
    <string name="disclosure_item_a11y_desc">Only used to detect when a chosen app opens so its overlay can start automatically, and to forward your touches through the overlay to the game underneath. It never reads or records your screen content.</string>
    <string name="disclosure_item_battery_title">Battery optimization exemption</string>
    <string name="disclosure_item_battery_desc">Keeps a running capture/frame-generation session from being paused or killed by the system while in the background.</string>
    <string name="disclosure_item_display_title">Per-app resolution &amp; DPI</string>
    <string name="disclosure_item_display_desc">WRITE_SECURE_SETTINGS, granted separately through Shizuku or a one-time ADB command on a computer, used only to change resolution/DPI for the app you launch.</string>
    <string name="disclosure_item_privacy_title">Nothing leaves your device</string>
    <string name="disclosure_item_privacy_desc">NovaFrame doesn\'t use the internet, collect analytics, or send anything off your device. Crash reports, if any, are saved locally only.</string>
    <string name="disclosure_footer">You can revisit this at any time from Settings → Setup.</string>
    <string name="disclosure_cta">Continue</string>

