    <string name="param_multiplier">Frame multiplier</string>
    <string name="param_multiplier_desc">Number of frames produced per real frame. 2 = one interpolated frame between each pair. 3–4 recommended on mobile.</string>
    <string name="param_flow_scale">Flow scale</string>
    <string name="param_flow_scale_desc">Internal motion estimation resolution. Lower = faster but less accurate.</string>
    <string name="param_render_resolution_scale">Render resolution</string>
    <string name="param_render_resolution_scale_desc">Percentage of the display\'s native resolution to capture and render at. Lower values cut GPU cost across capture and frame-gen, at the cost of a softer image. Takes effect on the next capture (re)start.</string>
    <string name="param_performance_mode">Performance mode (LSFG 3.1P)</string>
    <string name="param_performance_mode_desc">Use the faster, lower-quality shader variant. Recommended on mid-range GPUs.</string>
    <string name="param_hdr">HDR mode</string>
    <string name="param_hdr_desc">Enable only if your device and game output HDR.</string>
    <string name="param_framegen_fp16">FP16 frame-gen shaders</string>
    <string name="param_framegen_fp16_desc">Use the half-precision shader variants pre-compiled inside Lossless.dll instead of the full-precision FP32 set. Reduces GPU load and memory bandwidth. Quality is virtually identical; falls back to FP32 automatically if anything goes wrong.</string>

