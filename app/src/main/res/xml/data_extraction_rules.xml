<?xml version="1.0" encoding="utf-8"?>
<!-- SECURITY: only the app's own preference file may leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="scw_preferences.xml"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
        <exclude domain="root"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="scw_preferences.xml"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
        <exclude domain="root"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
