<?xml version="1.0" encoding="utf-8"?>
<!-- Reorganized Customization Settings - Material 3 -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_appearance">
        
        <Preference
            app:key="@string/key_app_theme_type"
            app:title="@string/theme"
            app:summary="@string/theme_explain"
            app:icon="@drawable/mozac_ic_themes_24"
            app:singleLineTitle="false"/>

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="dynamic_colors"
            app:title="@string/pref_dynamic_colors"
            app:summary="@string/pref_use_colors_from_your_wallpaper_android_1"
            app:singleLineTitle="false"
            app:defaultValue="false" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="amoled_mode"
            app:title="@string/pref_amoled_mode"
            app:summary="@string/pref_pure_black_background_for_oled_displays_"
            app:singleLineTitle="false"
            app:defaultValue="false" />

        <Preference
            app:key="@string/key_web_theme_type"
            app:title="@string/web_theme"
            app:summary="@string/web_theme_explain"
            app:singleLineTitle="false"/>

        <Preference
            app:key="@string/key_homepage_background_image"
            app:title="@string/homepage_background_image"
            app:summary="@string/none"
            app:singleLineTitle="false"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_toolbar_navigation">
        
        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_move_navbar"
            app:title="@string/move_navbar"
            app:singleLineTitle="false"
            app:defaultValue="false" />



        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_show_contextual_toolbar"
            app:title="@string/show_contextual_toolbar"
            app:summary="@string/show_contextual_toolbar_desc"
            app:singleLineTitle="false"
            app:defaultValue="true" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_show_tab_group_bar"
            app:title="@string/show_tab_group_bar"
            app:summary="@string/show_tab_group_bar_desc"
            app:singleLineTitle="false"
            app:defaultValue="true" />

        <Preference
            app:key="toolbar_icon_size"
            app:title="@string/toolbar_icon_size"
            app:summary="@string/toolbar_icon_size_desc"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_tabs_layout">
        
        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_show_tabs_in_grid"
            app:title="@string/tab_grid"
            app:singleLineTitle="false"
            app:defaultValue="true" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_swap_drawers"
            app:title="@string/swap_bookmarks_and_tabs"
            app:singleLineTitle="false"
            app:defaultValue="true" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_stack_from_bottom"
            app:title="@string/stack_items_reverse"
            app:singleLineTitle="false"
            app:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_homepage">
        
        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_shortcuts_visible"
            app:title="@string/show_shortcuts"
            app:singleLineTitle="false"
            app:defaultValue="true" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_load_shortcut_icons"
            app:title="@string/load_shortcut_icons"
            app:singleLineTitle="false"
            app:defaultValue="true" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="keep_wallpaper_dimmed"
            app:title="@string/pref_dim_homepage_wallpaper"
            app:summary="@string/pref_apply_semi_transparent_overlay_to_homepa"
            app:singleLineTitle="false"
            app:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_text_display">
        
        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_show_protocol"
            app:title="@string/show_protocol_in_url"
            app:singleLineTitle="false"
            app:defaultValue="false" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_auto_font_size"
            app:title="@string/auto_font"
            app:singleLineTitle="false"
            app:defaultValue="true" />

        <SeekBarPreference
            android:max="150"
            app:min="50"
            app:key="@string/key_font_size_factor"
            app:title="@string/font_size"
            app:showSeekBarValue="true"
            app:singleLineTitle="false"
            app:defaultValue="100" />

        <Preference
            app:key="interface_font_scale"
            app:title="@string/interface_font_scale"
            app:summary="@string/interface_font_scale_desc"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_gestures">
        
        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_swipe_refresh"
            app:title="@string/swipe_to_refresh"
            app:summary="@string/swipe_to_refresh_summary"
            app:singleLineTitle="false"
            app:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>