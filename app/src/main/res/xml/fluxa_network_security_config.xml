<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the certificate authorities that ship with the phone (user-installed CAs, as used by
     interception proxies, are not trusted) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
