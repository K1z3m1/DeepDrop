<?xml version="1.0" encoding="utf-8" ?>
<!-- Reorganized Advanced Settings - Material 3 with Grouping -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_downloads">
        
        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_prompt_external_downloader"
            app:title="@string/prompt_external_downloader"
            app:singleLineTitle="false"
            app:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_extension_management">
        
        <Preference
            app:key="@string/key_sideload_xpi"
            app:title="@string/load_xpi_link"
            app:icon="@drawable/ic_baseline_link"
            app:singleLineTitle="false"
            app:enabled="true" />

        <Preference
            app:key="@string/key_sideload_xpi_file"
            app:title="@string/load_xpi_file"
            app:icon="@drawable/ic_baseline_folder"
            app:singleLineTitle="false"
            app:enabled="true" />

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_use_custom_collection"
            app:title="@string/use_custom_collection"
            app:singleLineTitle="false"
            app:defaultValue="false" />

        <Preference
            app:key="@string/key_collection_user"
            app:title="@string/collection_user"
            app:singleLineTitle="false"
            app:enabled="false" />

        <Preference
            app:key="@string/key_collection_name"
            app:title="@string/collection_name"
            app:singleLineTitle="false"
            app:enabled="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_security">

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_trust_third_party_certs"
            app:title="@string/trust_third_party_certs"
            app:summary="@string/pref_warn_trust_certs"
            app:singleLineTitle="false"
            app:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_performance">

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_fast_page_load"
            app:title="@string/fast_page_load"
            app:summary="@string/fast_page_load_summary"
            app:singleLineTitle="false"
            app:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_developer_options">
        
        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_remote_debugging"
            app:title="@string/remote_debugging"
            app:summary="@string/pref_warn_remote_debugging"
            app:singleLineTitle="false"
            app:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
