<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy & Security Settings -->
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_enhanced_tracking_protection">

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_tracking_protection"
            app:title="@string/tracking_protection"
            app:icon="@drawable/mozac_ic_shield_24"
            app:singleLineTitle="false"
            app:defaultValue="true"/>

        <com.prirai.android.lr.settings.MaterialSwitchPreference
            app:key="@string/key_safe_browsing"
            app:title="@string/safe_browsing"
            app:icon="@drawable/mozac_ic_lock_24"
            app:singleLineTitle="false"
            app:defaultValue="true"/>

        <!-- Classic fingerprint resistance (letterboxing, canvas spoofing,
             uniform UA). Off by default: while enabled Gecko forces a light
             page theme (bug 1535189) and spoofs canvas readbacks, which broke
             picture uploads/downloads on some sites. Both the config-file
             pref and the typed setters are applied at engine construction,
             so the toggle takes effect on the next app start. -->
        <com.prirai.android.lr.settings.InfoSwitchPreference
            app:key="@string/key_resist_fingerprinting"
            app:title="@string/resist_fingerprinting"
            app:infoText="@string/resist_fingerprinting_summary"
            app:singleLineTitle="false"
            app:defaultValue="false" />

        <Preference
            app:key="etp_level"
            app:title="@string/pref_tracking_protection"
            app:summary="@string/pref_controls_how_lr_blocks_trackers_and_scri" />

        <PreferenceCategory
            app:key="etp_custom_categories"
            app:title="@string/pref_blocked_categories"
            app:summary="@string/pref_choose_what_to_block_in_custom_mode"
            app:initialExpandedChildrenCount="0">

            <com.prirai.android.lr.settings.MaterialSwitchPreference
                app:key="etp_tracking_ads"
                app:title="@string/pref_tracking_ads"
                app:summary="@string/pref_blocks_ads_that_track_your_browsing"
                app:defaultValue="true" />

            <com.prirai.android.lr.settings.MaterialSwitchPreference
                app:key="etp_tracking_content"
                app:title="@string/pref_tracking_content"
                app:summary="@string/pref_blocks_content_that_tracks_your_browsing"
                app:defaultValue="true" />

            <com.prirai.android.lr.settings.MaterialSwitchPreference
                app:key="etp_cryptominers"
                app:title="@string/pref_cryptominers"
                app:summary="@string/pref_blocks_scripts_that_mine_cryptocurrency"
                app:defaultValue="true" />

            <com.prirai.android.lr.settings.MaterialSwitchPreference
                app:key="etp_fingerprinters"
                app:title="@string/pref_fingerprinters"
                app:summary="@string/pref_blocks_scripts_that_fingerprint_your_dev"
                app:defaultValue="true" />

            <com.prirai.android.lr.settings.MaterialSwitchPreference
                app:key="etp_social_tracking"
                app:title="@string/pref_social_trackers"
                app:summary="@string/pref_blocks_social_media_tracking"
                app:defaultValue="true" />

            <com.prirai.android.lr.settings.MaterialSwitchPreference
                app:key="etp_email_tracking"
                app:title="@string/pref_email_tracking"
                app:summary="@string/pref_blocks_email_tracking_pixels"
                app:defaultValue="true" />

        </PreferenceCategory>

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/security_connections">

        <Preference
            app:key="@string/key_https_only"
            app:title="@string/https_only_title"
            app:summary="@string/https_only_summary" />

        <Preference
            app:key="@string/key_doh"
            app:title="@string/doh_title"
            app:summary="@string/doh_summary" />

        <Preference
            app:key="@string/key_doh_provider"
            app:title="@string/doh_provider_title" />

        <com.prirai.android.lr.settings.InfoSwitchPreference
            app:key="@string/key_global_privacy_control"
            app:title="@string/gpc_title"
            app:infoText="@string/gpc_summary"
            app:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_tabs_permissions">

        <Preference
            app:key="@string/key_clear_tabs"
            app:title="@string/clear_tabs"/>

        <Preference
            app:key="@string/key_site_exceptions"
            app:title="@string/site_exceptions_title"
            app:summary="@string/site_exceptions_summary"
            app:fragment="com.prirai.android.lr.settings.fragment.SiteExceptionsFragment" />

        <Preference
            app:key="@string/key_clear_permissions"
            app:title="@string/clear_permissions"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/performance_title">

        <Preference
            app:key="@string/key_sleeping_tabs"
            app:title="@string/sleeping_tabs_title"
            app:summary="@string/sleeping_tabs_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_clear_browsing_data">

        <Preference
            app:key="@string/key_clear_history"
            app:title="@string/clear_history"/>

        <Preference
            app:key="@string/key_clear_cookies"
            app:title="@string/clear_cookies"/>

        <Preference
            app:key="@string/key_clear_cache"
            app:title="@string/clear_cache"/>

    </PreferenceCategory>

</PreferenceScreen>