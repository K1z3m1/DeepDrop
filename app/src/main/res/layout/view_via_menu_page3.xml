<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="5">
        <LinearLayout
            android:id="@+id/btn_via_add_homescreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_add_homescreen"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_smartphone" />
            <TextView
                android:id="@+id/text_via_add_homescreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Instalar app"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_orientation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_orientation"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_via_rotation" />
            <TextView
                android:id="@+id/text_via_orientation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Orientación"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_adblock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_adblock"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_via_adblock" />
            <TextView
                android:id="@+id/text_via_adblock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bloqueo de anuncios"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_mark_ad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_mark_ad"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_via_mark_ad" />
            <TextView
                android:id="@+id/text_via_mark_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Marcar como anuncio"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_text_size"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_text_size"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_text_size" />
            <TextView
                android:id="@+id/text_via_text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tamaño del texto"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="5">
        <LinearLayout
            android:id="@+id/btn_via_copy_link"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_copy_link"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_content_copy_black" />
            <TextView
                android:id="@+id/text_via_copy_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Copiar enlace"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_open_in_app"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_open_in_app"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_open_in_new" />
            <TextView
                android:id="@+id/text_via_open_in_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Abrir en app"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_print"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_print"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_print" />
            <TextView
                android:id="@+id/text_via_print"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Imprimir / PDF"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_save_page"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_save_page"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file_download_black" />
            <TextView
                android:id="@+id/text_via_save_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Guardar página"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_via_reading_mode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_via_reading_mode"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_action_reading" />
            <TextView
                android:id="@+id/text_via_reading_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Modo lectura"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
