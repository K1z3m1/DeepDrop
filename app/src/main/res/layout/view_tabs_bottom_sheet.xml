<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabs_bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_via_menu_bg_dark"
    android:orientation="vertical"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/tabs_bottom_handle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/handle_pill" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabs_bottom_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <View
        android:id="@+id/tabs_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14FFFFFF" />

    <FrameLayout
        android:id="@+id/btn_tabs_bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/btn_tabs_bottom_new_tab_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/action_new_tab"
            app:srcCompat="@drawable/ic_action_plus"
            app:tint="#FFFFFF" />
    </FrameLayout>

</LinearLayout>
