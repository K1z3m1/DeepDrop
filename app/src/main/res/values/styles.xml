<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Settings themes -->
    <style name="Theme.SettingsTheme" parent="Theme.LightTheme">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="colorAccent">#2A60F5</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Compact</item>
    </style>

    <style name="Theme.SettingsTheme.Dark" parent="Theme.DarkTheme">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="colorPrimary">?android:attr/colorBackground</item>
        <item name="colorAccent">#5C87F7</item>
        <item name="toolbarSettingsBackground">@drawable/toolbar_elevate_dark</item>
        <!-- Dark settings has a special primary dark -->
        <item name="colorPrimaryDark">@color/secondary_color_settings_dark</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Compact</item>
    </style>

    <style name="Theme.SettingsTheme.Black" parent="Theme.BlackTheme">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="colorPrimary">?android:attr/colorBackground</item>
        <item name="colorPrimaryDark">?android:attr/colorBackground</item>
        <item name="colorAccent">#5C87F7</item>
        <item name="toolbarSettingsBackground">@drawable/toolbar_elevate_black</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Compact</item>
    </style>

    <!-- Compact Preference Styles (Modern, Sleek, 46dp) -->
    <style name="PreferenceThemeOverlay.Compact" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/PreferenceCategory.Compact</item>
        <item name="preferenceStyle">@style/Preference.Compact</item>
        <item name="switchPreferenceStyle">@style/SwitchPreference.Compact</item>
        <item name="switchPreferenceCompatStyle">@style/SwitchPreference.Compact</item>
        <item name="checkBoxPreferenceStyle">@style/Preference.Compact</item>
    </style>

    <style name="PreferenceCategory.Compact" parent="@style/Preference.Category">
        <item name="android:layout">@layout/preference_category_compact</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Preference.Compact" parent="@style/Preference">
        <item name="android:layout">@layout/preference_compact</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="SwitchPreference.Compact" parent="@style/Preference.SwitchPreferenceCompat">
        <item name="android:layout">@layout/preference_compact</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!-- Regular themes -->
    <style name="Theme.LightTheme" parent="Theme.BaseLightTheme">
        <item name="searchBackground">@drawable/card_bg_elevate</item>
        <item name="listBackground">@drawable/list_bg</item>
        <item name="progressBackgroundColor">@color/cookie_dark</item>
    </style>

    <style name="Theme.DarkTheme" parent="Theme.BaseDarkTheme">
        <item name="searchBackground">@drawable/search_bg_dark</item>
        <item name="listBackground">@drawable/list_bg</item>
        <item name="progressBackgroundColor">@color/cookie_dark</item>
    </style>

    <style name="Theme.BlackTheme" parent="Theme.BaseBlackTheme">
        <item name="searchBackground">@drawable/search_bg_black</item>
        <item name="listBackground">@drawable/list_bg</item>
        <item name="progressBackgroundColor">@color/black</item>
    </style>

    <!-- Base Themes -->
    <style name="Theme.BaseLightTheme" parent="Theme.Material3.DynamicColors.Light">

        <!-- Theme Colors -->
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorAccent">@color/gray</item>
        <item name="drawerBackground">@color/drawer_background</item>
        <item name="dividerColor">@color/divider_light</item>

        <item name="android:colorBackground">@color/white</item>

        <item name="iconColor">@color/icon_light_theme</item>
        <item name="iconColorState">@color/state_color_icons_light</item>

        <item name="autoCompleteTitleColor">@color/black</item>
        <item name="autoCompleteUrlColor">@color/hint_text_light_theme</item>

        <item name="selectedBackground">@color/selected_light</item>
        <item name="bottomBarBackground">@drawable/bottom_bar_bg_light</item>

        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Overflow menu -->
        <item name="actionOverflowButtonStyle">@style/overFlowButtonStyle</item>

        <!-- Alert dialogs -->
        <item name="alertDialogTheme">@style/ModernDialogStyle.Light</item>
        <item name="materialAlertDialogTheme">@style/ModernDialogStyle.Light</item>

    </style>

    <style name="Theme.BaseDarkTheme" parent="Theme.Material3.DynamicColors.Dark">

        <!-- Theme colors -->
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/cookie_light</item>
        <item name="drawerBackground">@color/drawer_background_dark</item>
        <item name="dividerColor">@color/divider_dark</item>

        <item name="android:colorBackground">@color/black</item>

        <item name="iconColor">@color/icon_dark_theme</item>
        <item name="iconColorState">@color/state_color_icons_dark</item>

        <item name="autoCompleteTitleColor">@color/white</item>
        <item name="autoCompleteUrlColor">@color/hint_text_dark_theme</item>

        <item name="selectedBackground">@color/selected_dark</item>
        <item name="bottomBarBackground">@drawable/bottom_bar_bg_dark</item>
        <item name="colorSurface">@color/black</item>

        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Overflow menu -->
        <item name="actionOverflowButtonStyle">@style/overFlowButtonStyle</item>

        <!-- Alert dialogs -->
        <item name="alertDialogTheme">@style/ModernDialogStyle.Dark</item>
        <item name="materialAlertDialogTheme">@style/ModernDialogStyle.Dark</item>

    </style>

    <style name="Theme.BaseBlackTheme" parent="Theme.Material3.DynamicColors.Dark">

        <!-- Theme colors -->
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/cookie_light</item>
        <item name="drawerBackground">@color/black</item>
        <item name="dividerColor">#1E1E1E</item>

        <item name="android:colorBackground">@color/black</item>

        <item name="iconColor">@color/icon_dark_theme</item>
        <item name="iconColorState">@color/state_color_icons_dark</item>

        <item name="autoCompleteTitleColor">@color/white</item>
        <item name="autoCompleteUrlColor">@color/hint_text_dark_theme</item>

        <item name="selectedBackground">@color/selected_dark</item>
        <item name="bottomBarBackground">@drawable/bottom_bar_bg_black</item>
        <item name="colorSurface">@color/black</item>

        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Overflow menu -->
        <item name="actionOverflowButtonStyle">@style/overFlowButtonStyle</item>

        <!-- Alert dialogs -->
        <item name="alertDialogTheme">@style/ModernDialogStyle.Dark</item>
        <item name="materialAlertDialogTheme">@style/ModernDialogStyle.Dark</item>

    </style>

    <!-- Modern Compact Dialog Styles -->
    <style name="ModernDialogStyle.Light" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@drawable/dialog_rounded_bg_light</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleText.Light</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyText.Light</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton</item>
        <item name="colorAccent">#5C87F7</item>
        <item name="colorPrimary">#5C87F7</item>
    </style>

    <style name="ModernDialogStyle.Dark" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@drawable/dialog_rounded_bg_dark</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleText.Dark</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyText.Dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton</item>
        <item name="colorAccent">#5C87F7</item>
        <item name="colorPrimary">#5C87F7</item>
    </style>

    <style name="ShapeAppearance.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="DialogTitleText.Light" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">15.5sp</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DialogTitleText.Dark" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">15.5sp</item>
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DialogBodyText.Light" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">#4A4A4A</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="DialogBodyText.Dark" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#5C87F7</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <!-- Legacy AlertDialog Fallback -->
    <style name="AppCompatDialogStyle.Light" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#5C87F7</item>
    </style>

    <style name="AppCompatDialogStyle.Dark" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#5C87F7</item>
    </style>

    <style name="AppCompatDialogStyle.Black" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#5C87F7</item>
    </style>

    <!-- Overflow Menu Customization -->
    <style name="overFlowButtonStyle" parent="@style/Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- Text Customization -->
    <style name="boldText">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="normalText">
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ToolbarAnim">
        <item name="android:windowEnterAnimation">@anim/toolbar_in</item>
        <item name="android:windowExitAnimation">@anim/toolbar_out</item>
    </style>

    <style name="ToolbarAnimReverse">
        <item name="android:windowEnterAnimation">@anim/toolbar_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/toolbar_out_bottom</item>
    </style>

    <style name="ViaBottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/ViaBottomSheetModalStyle</item>
    </style>

    <style name="ViaBottomSheetModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ActiveIndicator.None" parent="">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <style name="SettingsToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
