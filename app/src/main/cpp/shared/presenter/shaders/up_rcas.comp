// FSR 1 robust contrast-adaptive sharpening (RCAS), as a Vulkan compute pass over an image that
// is already at output size. Algorithm: AMD FidelityFX Super Resolution 1.0 (MIT licence,
// Copyright (c) 2021 Advanced Micro Devices, Inc.).

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex;
layout(set = 0, binding = 1) uniform writeonly image2D dstImg;

layout(push_constant) uniform PC {
    float srcW;
    float srcH;
    float dstW;
    float dstH;
    float sharp; // RCAS strength 0.25 (soft) .. 1.0 (sharpest)
    float p1;    // overdrive 0 .. 1: extrapolates the RCAS result past its safe limit (strength 100% .. 200%)
} pc;

const float RCAS_LIMIT = 0.25 - (1.0 / 16.0);

vec3 fetchRGB(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(int(pc.dstW) - 1, int(pc.dstH) - 1));
    return texelFetch(srcTex, p, 0).rgb;
}

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(pc.dstW) || ip.y >= int(pc.dstH)) return;

    //    b
    //  d e f
    //    h
    vec3 b = fetchRGB(ip + ivec2(0, -1));
    vec3 d = fetchRGB(ip + ivec2(-1, 0));
    vec3 e = fetchRGB(ip);
    vec3 f = fetchRGB(ip + ivec2(1, 0));
    vec3 h = fetchRGB(ip + ivec2(0, 1));

    vec3 mn4 = min(min(b, d), min(f, h));
    vec3 mx4 = max(max(b, d), max(f, h));

    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1e-4));
    vec3 hitMax = (vec3(1.0) - max(mx4, e)) / min(4.0 * mn4 - vec3(4.0), vec3(-1e-4));
    vec3 lobe3 = max(-hitMin, hitMax);
    float lobe = max(lobe3.r, max(lobe3.g, lobe3.b));
    lobe = max(-RCAS_LIMIT, min(lobe, 0.0)) * pc.sharp;

    vec3 pix = (lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0);
    // 100% is the strongest the RCAS lobe can go without blowing up; above that push the result
    // further along the same direction (up to 4x the change), then clamp to the legal range
    pix = e + (pix - e) * (1.0 + 3.0 * clamp(pc.p1, 0.0, 1.0));
    imageStore(dstImg, ip, vec4(clamp(pix, 0.0, 1.0), 1.0));
}
