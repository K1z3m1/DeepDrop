// Catmull-Rom (bicubic, B = 0, C = 0.5) upscaler as a single Vulkan compute pass.
// Uses the usual 9-tap formulation: the two middle taps of every row / column of the 4x4 kernel are
// merged into one hardware-filtered fetch (offset by w2 / (w1 + w2)), so 9 samples give exactly
// the same result as the 16-tap kernel. Needs only plain bilinear sampling, no extension.

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex; // linear, clamp-to-edge
layout(set = 0, binding = 1) uniform writeonly image2D dstImg;

layout(push_constant) uniform PC {
    float srcW;
    float srcH;
    float dstW;
    float dstH;
    float sharp; // unused here
} pc;

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(pc.dstW) || ip.y >= int(pc.dstH)) return;

    vec2 srcSize = vec2(pc.srcW, pc.srcH);
    vec2 pos = (vec2(ip) + 0.5) * (srcSize / vec2(pc.dstW, pc.dstH)); // position in source pixels
    vec2 t1 = floor(pos - 0.5) + 0.5;                                  // centre of the texel at/before pos
    vec2 f = pos - t1;                                                 // 0..1 between t1 and t1 + 1

    // Catmull-Rom weights of the four taps around pos (they sum to 1)
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;          // 1 + 0.5 f - 0.5 f^2, always in [1, 1.125]
    vec2 off12 = w2 / w12;

    vec2 p0 = (t1 - 1.0) / srcSize;
    vec2 p3 = (t1 + 2.0) / srcSize;
    vec2 p12 = (t1 + off12) / srcSize;

    vec3 c = vec3(0.0);
    c += texture(srcTex, vec2(p0.x, p0.y)).rgb * (w0.x * w0.y);
    c += texture(srcTex, vec2(p12.x, p0.y)).rgb * (w12.x * w0.y);
    c += texture(srcTex, vec2(p3.x, p0.y)).rgb * (w3.x * w0.y);

    c += texture(srcTex, vec2(p0.x, p12.y)).rgb * (w0.x * w12.y);
    c += texture(srcTex, vec2(p12.x, p12.y)).rgb * (w12.x * w12.y);
    c += texture(srcTex, vec2(p3.x, p12.y)).rgb * (w3.x * w12.y);

    c += texture(srcTex, vec2(p0.x, p3.y)).rgb * (w0.x * w3.y);
    c += texture(srcTex, vec2(p12.x, p3.y)).rgb * (w12.x * w3.y);
    c += texture(srcTex, vec2(p3.x, p3.y)).rgb * (w3.x * w3.y);

    imageStore(dstImg, ip, vec4(clamp(c, 0.0, 1.0), 1.0));
}
