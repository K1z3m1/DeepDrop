// AMD FidelityFX Contrast Adaptive Sharpening (CAS) as a Vulkan compute pass over an image that
// is already at output size. Alternative to the RCAS pass: it adapts the amount of sharpening to
// the local contrast (per colour channel) and uses a 3x3 neighbourhood. Algorithm: AMD FidelityFX
// CAS (MIT licence, Advanced Micro Devices, Inc.).

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex;
layout(set = 0, binding = 1) uniform writeonly image2D dstImg;

layout(push_constant) uniform PC {
    float srcW;
    float srcH;
    float dstW;
    float dstH;
    float sharp; // CAS sharpness 0 (gentle) .. 1 (strongest)
    float p1;    // overdrive 0 .. 1: strength 100% .. 200%
} pc;

vec3 fetchRGB(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(int(pc.dstW) - 1, int(pc.dstH) - 1));
    return texelFetch(srcTex, p, 0).rgb;
}

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(pc.dstW) || ip.y >= int(pc.dstH)) return;

    //  a b c
    //  d e f
    //  g h i
    vec3 a = fetchRGB(ip + ivec2(-1, -1));
    vec3 b = fetchRGB(ip + ivec2(0, -1));
    vec3 c = fetchRGB(ip + ivec2(1, -1));
    vec3 d = fetchRGB(ip + ivec2(-1, 0));
    vec3 e = fetchRGB(ip);
    vec3 f = fetchRGB(ip + ivec2(1, 0));
    vec3 g = fetchRGB(ip + ivec2(-1, 1));
    vec3 h = fetchRGB(ip + ivec2(0, 1));
    vec3 i = fetchRGB(ip + ivec2(1, 1));

    // soft min / max: (plus-shaped min + 3x3 min); both sums are 2x larger than the true values
    vec3 mn = min(min(min(d, e), min(f, b)), h);
    vec3 mn2 = min(min(min(mn, a), min(c, g)), i);
    mn = mn + mn2;
    vec3 mx = max(max(max(d, e), max(f, b)), h);
    vec3 mx2 = max(max(max(mx, a), max(c, g)), i);
    mx = mx + mx2;

    // smooth minimum distance to the signal limit, divided by the smooth max
    vec3 amp = clamp(min(mn, vec3(2.0) - mx) / max(mx, vec3(1.0e-4)), 0.0, 1.0);
    amp = sqrt(amp);

    // filter shape:  0 w 0 / w 1 w / 0 w 0
    float peak = -1.0 / mix(8.0, 5.0, clamp(pc.sharp, 0.0, 1.0));
    vec3 w = amp * peak;
    vec3 pix = (b * w + d * w + f * w + h * w + e) / (vec3(1.0) + 4.0 * w);
    // above 100%: push further along the same direction (up to 4x the change)
    pix = e + (pix - e) * (1.0 + 3.0 * clamp(pc.p1, 0.0, 1.0));
    imageStore(dstImg, ip, vec4(clamp(pix, 0.0, 1.0), 1.0));
}
