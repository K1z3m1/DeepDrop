// Edge-adaptive single-pass upscaler in the style of Snapdragon Game Super Resolution 1.x:
// bilinear colour plus a clamped luma correction rebuilt from a 12-tap neighbourhood with an
// edge-aligned Lanczos-2 style kernel. Written from the published description of the method;
// this is NOT Qualcomm's shader file (drop the official BSD-3 sgsr1 shader in its place if
// bit-exact output is wanted).

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex; // linear, clamp-to-edge
layout(set = 0, binding = 1) uniform writeonly image2D dstImg;

layout(push_constant) uniform PC {
    float srcW;
    float srcH;
    float dstW;
    float dstH;
    float sharp; // unused here (RCAS strength)
} pc;

const float EDGE_THRESHOLD = 8.0 / 255.0;
const float EDGE_SHARPNESS = 2.0;
const float MAX_DELTA = 23.0 / 255.0;

vec3 fetchRGB(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(int(pc.srcW) - 1, int(pc.srcH) - 1));
    return texelFetch(srcTex, p, 0).rgb;
}

float lumaOf(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

float fastLanczos2(float x) {
    float wA = x - 4.0;
    float wB = x * wA - wA;
    wA *= wA;
    return wB * wA;
}

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(pc.dstW) || ip.y >= int(pc.dstH)) return;

    vec2 scale = vec2(pc.srcW / pc.dstW, pc.srcH / pc.dstH);
    vec2 pp = (vec2(ip) + 0.5) * scale - 0.5;
    vec2 fpv = floor(pp);
    ivec2 fp = ivec2(fpv);
    vec2 fr = pp - fpv;

    vec3 base = texture(srcTex, (pp + 0.5) / vec2(pc.srcW, pc.srcH)).rgb;

    //    b c
    //  e f g h
    //  i j k l
    //    n o
    const ivec2 OFF[12] = ivec2[12](
        ivec2(0, -1), ivec2(1, -1),
        ivec2(-1, 0), ivec2(0, 0), ivec2(1, 0), ivec2(2, 0),
        ivec2(-1, 1), ivec2(0, 1), ivec2(1, 1), ivec2(2, 1),
        ivec2(0, 2), ivec2(1, 2));

    float L[12];
    for (int t = 0; t < 12; t++) L[t] = lumaOf(fetchRGB(fp + OFF[t]));
    // indices: 0 b, 1 c, 2 e, 3 f, 4 g, 5 h, 6 i, 7 j, 8 k, 9 l, 10 n, 11 o

    float mean = 0.25 * (L[3] + L[4] + L[7] + L[8]);
    float cMin = min(min(L[3], L[4]), min(L[7], L[8])) - mean;
    float cMax = max(max(L[3], L[4]), max(L[7], L[8])) - mean;

    // flat area: nothing to reconstruct
    if (cMax - cMin < EDGE_THRESHOLD) {
        imageStore(dstImg, ip, vec4(base, 1.0));
        return;
    }

    float gx = (L[4] + L[8] + 0.5 * (L[5] + L[9])) - (L[3] + L[7] + 0.5 * (L[2] + L[6]));
    float gy = (L[7] + L[8] + 0.5 * (L[10] + L[11])) - (L[3] + L[4] + 0.5 * (L[0] + L[1]));
    float gl = length(vec2(gx, gy));
    vec2 edge = gl > 1e-5 ? vec2(gy, -gx) / gl : vec2(1.0, 0.0); // along the edge

    float sumAbs = 0.0;
    for (int t = 0; t < 12; t++) sumAbs += abs(L[t] - mean);
    float k = 10.14185 / max(sumAbs, 1e-4);
    float std2 = k * k;

    float wSum = 0.0;
    float lSum = 0.0;
    for (int t = 0; t < 12; t++) {
        float c = L[t] - mean;
        vec2 d = vec2(OFF[t]) - fr;
        float along = dot(d, edge);
        float x = dot(d, d) + along * along * (clamp(c * c * std2, 0.0, 1.0) * 0.7 - 1.0);
        float w = fastLanczos2(min(max(x, 0.0), 4.0));
        wSum += w;
        lSum += w * c;
    }
    if (abs(wSum) < 1e-5) {
        imageStore(dstImg, ip, vec4(base, 1.0));
        return;
    }

    float finalY = clamp(EDGE_SHARPNESS * (lSum / wSum), cMin, cMax);
    float baseY = lumaOf(base) - mean;
    float delta = clamp(finalY - baseY, -MAX_DELTA, MAX_DELTA);
    imageStore(dstImg, ip, vec4(clamp(base + vec3(delta), 0.0, 1.0), 1.0));
}
