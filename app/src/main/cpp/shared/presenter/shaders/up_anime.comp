// Line-push upscaler for flat-shaded / anime style content (inspired by Anime4K's non-CNN "push"
// idea; it does NOT use the Anime4K neural-network weights).
// Pass 1 of 1: Catmull-Rom base colour, then a shock-filter style edge push: along the luma
// gradient the pixel is pulled towards the darker or lighter side of the edge it sits on, which
// thins and steepens lines instead of blurring them. The result never leaves the colour range of
// the two edge sides, so it cannot ring. Needs only plain bilinear sampling.

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex; // linear, clamp-to-edge
layout(set = 0, binding = 1) uniform writeonly image2D dstImg;

layout(push_constant) uniform PC {
    float srcW;
    float srcH;
    float dstW;
    float dstH;
    float sharp; // unused here (the sharpen pass follows)
} pc;

const float PUSH_STRENGTH = 0.85; // 0 = plain Catmull-Rom, 1 = fully snapped to the nearer side
const float EDGE_GAIN = 10.0;     // how fast the push fades in with edge contrast
const float SIDE_DIST = 1.0;      // distance (source px) to the two side samples

float lumaOf(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

vec3 samplePx(vec2 posPx) {
    return texture(srcTex, posPx / vec2(pc.srcW, pc.srcH)).rgb;
}

vec3 catmullRom(vec2 pos) {
    vec2 srcSize = vec2(pc.srcW, pc.srcH);
    vec2 t1 = floor(pos - 0.5) + 0.5;
    vec2 f = pos - t1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 off12 = w2 / w12;
    vec2 p0 = (t1 - 1.0) / srcSize;
    vec2 p3 = (t1 + 2.0) / srcSize;
    vec2 p12 = (t1 + off12) / srcSize;

    vec3 c = vec3(0.0);
    c += texture(srcTex, vec2(p0.x, p0.y)).rgb * (w0.x * w0.y);
    c += texture(srcTex, vec2(p12.x, p0.y)).rgb * (w12.x * w0.y);
    c += texture(srcTex, vec2(p3.x, p0.y)).rgb * (w3.x * w0.y);
    c += texture(srcTex, vec2(p0.x, p12.y)).rgb * (w0.x * w12.y);
    c += texture(srcTex, vec2(p12.x, p12.y)).rgb * (w12.x * w12.y);
    c += texture(srcTex, vec2(p3.x, p12.y)).rgb * (w3.x * w12.y);
    c += texture(srcTex, vec2(p0.x, p3.y)).rgb * (w0.x * w3.y);
    c += texture(srcTex, vec2(p12.x, p3.y)).rgb * (w12.x * w3.y);
    c += texture(srcTex, vec2(p3.x, p3.y)).rgb * (w3.x * w3.y);
    return clamp(c, 0.0, 1.0);
}

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(pc.dstW) || ip.y >= int(pc.dstH)) return;

    vec2 pos = (vec2(ip) + 0.5) * (vec2(pc.srcW, pc.srcH) / vec2(pc.dstW, pc.dstH));
    vec3 base = catmullRom(pos);

    // luma gradient around the sample point (central differences, 1 source pixel apart)
    float lL = lumaOf(samplePx(pos + vec2(-1.0, 0.0)));
    float lR = lumaOf(samplePx(pos + vec2(1.0, 0.0)));
    float lU = lumaOf(samplePx(pos + vec2(0.0, -1.0)));
    float lD = lumaOf(samplePx(pos + vec2(0.0, 1.0)));
    vec2 g = vec2(lR - lL, lD - lU);
    float mag = length(g);
    if (mag < 1.0e-3) {
        imageStore(dstImg, ip, vec4(base, 1.0));
        return;
    }
    vec2 n = g / mag;

    vec3 sideA = samplePx(pos - n * SIDE_DIST);
    vec3 sideB = samplePx(pos + n * SIDE_DIST);
    float la = lumaOf(sideA);
    float lb = lumaOf(sideB);
    vec3 dark = la < lb ? sideA : sideB;
    vec3 light = la < lb ? sideB : sideA;
    float ld = min(la, lb);
    float ll = max(la, lb);
    float span = ll - ld;
    if (span < 1.0e-3) {
        imageStore(dstImg, ip, vec4(base, 1.0));
        return;
    }

    float t = clamp((lumaOf(base) - ld) / span, 0.0, 1.0); // 0 = dark side, 1 = light side
    vec3 target = t > 0.5 ? light : dark;
    float mid = 4.0 * t * (1.0 - t);                       // strongest in the middle of the edge
    float amount = PUSH_STRENGTH * clamp(span * EDGE_GAIN, 0.0, 1.0) * mid;
    vec3 res = mix(base, target, amount);
    imageStore(dstImg, ip, vec4(clamp(res, 0.0, 1.0), 1.0));
}
