// Lanczos-2 upscaler (4x4 taps, separable weights) as a single Vulkan compute pass, with a light
// anti-ringing clamp against the four source pixels around the sample point so hard edges do not
// grow halos. Sharper than bilinear / Catmull-Rom, needs no extension.

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex;
layout(set = 0, binding = 1) uniform writeonly image2D dstImg;

layout(push_constant) uniform PC {
    float srcW;
    float srcH;
    float dstW;
    float dstH;
    float sharp; // unused here
} pc;

// 0 = pure Lanczos, 1 = fully clamped to the local min / max (no overshoot at all)
const float ANTI_RINGING = 0.8;

vec3 fetchRGB(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(int(pc.srcW) - 1, int(pc.srcH) - 1));
    return texelFetch(srcTex, p, 0).rgb;
}

float lanczos2(float d) {
    d = abs(d);
    if (d < 1e-4) return 1.0;
    if (d >= 2.0) return 0.0;
    float pd = 3.14159265 * d;
    return 2.0 * sin(pd) * sin(0.5 * pd) / (pd * pd);
}

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(pc.dstW) || ip.y >= int(pc.dstH)) return;

    vec2 scale = vec2(pc.srcW / pc.dstW, pc.srcH / pc.dstH);
    vec2 pp = (vec2(ip) + 0.5) * scale - 0.5;
    vec2 fpv = floor(pp);
    ivec2 fp = ivec2(fpv);
    vec2 fr = pp - fpv;

    float wx[4];
    float wy[4];
    for (int i = 0; i < 4; i++) {
        wx[i] = lanczos2(float(i - 1) - fr.x);
        wy[i] = lanczos2(float(i - 1) - fr.y);
    }
    float norm = (wx[0] + wx[1] + wx[2] + wx[3]) * (wy[0] + wy[1] + wy[2] + wy[3]);

    vec3 acc = vec3(0.0);
    vec3 lo = vec3(1.0e9);
    vec3 hi = vec3(-1.0e9);
    for (int j = 0; j < 4; j++) {
        vec3 row = vec3(0.0);
        for (int i = 0; i < 4; i++) {
            vec3 c = fetchRGB(fp + ivec2(i - 1, j - 1));
            row += c * wx[i];
            if (i == 1 || i == 2) {
                if (j == 1 || j == 2) {
                    lo = min(lo, c);
                    hi = max(hi, c);
                }
            }
        }
        acc += row * wy[j];
    }

    vec3 res = acc / max(norm, 1.0e-4);
    res = mix(res, clamp(res, lo, hi), ANTI_RINGING);
    imageStore(dstImg, ip, vec4(clamp(res, 0.0, 1.0), 1.0));
}
