{
  "manifest_version": 2,
  "name": "LR Image Reader",
  "short_name": "LRImageReader",
  "description": "Collects every image on the current page (resolving original-resolution URLs) and hands the list to LR's full-screen image reader.",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "lr-image-reader@prirai.android.lr"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
